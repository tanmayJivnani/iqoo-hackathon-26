{
  "expo": {
    "name": "Pune Tree Rakshak",
    "slug": "pune-tree-rakshak",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "punetrees",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "org.punetrees.app",
      "adaptiveIcon": {
        "backgroundColor": "#19392A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Pune Tree Rakshak uses the camera to document tree concerns.", "recordAudioAndroid": false }],
      ["expo-location", { "locationWhenInUsePermission": "Pune Tree Rakshak uses your location to attach GPS coordinates to a tree report." }],
      ["expo-image-picker", { "photosPermission": "Pune Tree Rakshak uses selected photos as tree evidence.", "cameraPermission": "Pune Tree Rakshak uses the camera to capture evidence.", "microphonePermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19392A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-mail-composer",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
