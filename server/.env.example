GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-plus
# Absolute paths recommended when overriding the local defaults.
# DATA_DIR=C:/Repos/automated-tree-complaint/server/data
# DATABASE_PATH=C:/Repos/automated-tree-complaint/server/data/complaints.db
# PUBLIC_BASE_URL=https://your-tunnel-host.example
# CORS_ORIGINS=http://localhost:8081,http://localhost:3000
