# -------------------------------------------------------------
# AI Vision & Multimodal Inference Keys
# -------------------------------------------------------------
# Primary Fast Vision AI (Google AI Studio - Gemini 3.6 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Fallback Vision AI (OpenRouter - Qwen 3 VL)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# Default: SQLite local, can be Supabase/Neon PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./pune_trees.db

# -------------------------------------------------------------
# Optional: Live SMTP Email Dispatch (Simulated by default if blank)
# -------------------------------------------------------------
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
