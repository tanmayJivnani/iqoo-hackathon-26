# OpenRouter API Key for Qwen3-VL 32B Multimodal Vision & Drafting
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct

# Database (Default: SQLite local, can be Supabase/Neon PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./pune_trees.db

# SMTP Configuration for Official Grievance Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=complaints@punetrees.org

# PMC Official Contact Defaults
PMC_TREE_AUTHORITY_EMAIL=treeauthority@punecorporation.org
PMC_DISASTER_CELL_EMAIL=disastermanagement@punecorporation.org
PMC_GENERAL_FEEDBACK_EMAIL=feedback@punecorporation.org
PMC_WHATSAPP_HELPLINE=919689900002
